+    for (size_t i = 1; i < eu868ChannelsMhz.size(); ++i)
+        if (std::abs(eu868ChannelsMhz[i] - node.currentChannelMhz) <
+                std::abs(eu868ChannelsMhz[currentChannelIndex] - node.currentChannelMhz))
